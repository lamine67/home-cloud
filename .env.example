# Скопируйте в .env (cp .env.example .env) и заполните. Проще всего: python scripts/init_env.py
# Файл .env нельзя публиковать и коммитить: он в .gitignore.

# ── Обязательное ─────────────────────────────────────────────────────
# Ключ подписи сессий. Минимум 32 случайных символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string

# Первый администратор. Используется ТОЛЬКО при первом запуске, пока в базе нет ни одного пользователя.
# После создания аккаунта ADMIN_PASSWORD можно удалить из файла.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Каталоги ─────────────────────────────────────────────────────────
# База данных (SQLite) и временные файлы.
DATA_DIR=./data
# Общая папка: читать могут все пользователи (по умолчанию внутри DATA_DIR).
#STORAGE_DIR=./data/storage
# Личные папки пользователей: personal/<логин> (по умолчанию внутри DATA_DIR).
#PERSONAL_DIR=./data/personal

# ── Поведение ────────────────────────────────────────────────────────
# Название в заголовке окна и в приложении-аутентификаторе.
APP_NAME=Домашний Диск
# Кто может менять общую папку: admin | users | none
SHARED_WRITE=admin
# true, если сайт открыт по HTTPS (рекомендуется). Для проверки по http://IP:порт поставьте false.
COOKIE_SECURE=true
# true, если перед приложением стоит обратный прокси (nginx/Caddy): тогда адрес клиента берётся из X-Forwarded-For.
# Включайте только если до приложения нельзя достучаться в обход прокси.
TRUST_PROXY=false
# Срок жизни входа, дней.
SESSION_DAYS=30
# Быстрый вход: на доверенном устройстве с включённой 2FA хватает одного кода без пароля. По умолчанию выключено.
ALLOW_QUICK_LOGIN=false
# Сколько дней не спрашивать код 2FA на устройстве после успешного ввода (0 = спрашивать всегда).
TOTP_TRUST_DAYS=0

# ── Ограничения ──────────────────────────────────────────────────────
# Папки и выбранное в zip не архивируются, если есть файл крупнее (МБ).
ZIP_MAX_FILE_MB=300
# Максимальный суммарный размер распаковываемого zip (МБ).
EXTRACT_MAX_MB=4096
# Защита от подбора пароля: попыток входа за окно (секунды).
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SEC=600
